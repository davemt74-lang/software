<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^private(?:/|$) - [F,L,NC]
# Stable public profile namespace. The visible system-agent name may change
# without changing or breaking user profile URLs.
RewriteRule ^stonefellow/([A-Za-z0-9._-]+)/?$ profile.php?username=$1 [L,QSA,NC]
</IfModule>
<FilesMatch "^(?:config\.php|config-example\.php|schema\.sql|upgrade-.*\.sql|\.env.*)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always set Permissions-Policy "microphone=(self), camera=(self)"
<FilesMatch "^(?:premium-voice-v117|chat-voice-v117|editor-voice-barge-v117|voice-lease-v122|conversation-voice-v120|conversation-voice-v121|conversation-voice-v122|chat-conversation-v121|editor-agent-v114|stem-agent-v114|video-header-v92)\.js$">
Header always set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>
