<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^private(?:/|$) - [F,L,NC]

# Profile images remain physically private under /uploads. Route only the
# generated avatar/cover filenames through the visibility-aware PHP reader.
RewriteRule ^uploads/(avatars|profile-covers)/([A-Fa-f0-9]{32}\.(?:jpe?g|png|webp))$ api/profile-media.php?bucket=$1&file=$2 [L,QSA,NC]

# Legacy profile URLs permanently collapse to the canonical root username URL.
RewriteRule ^stonefellow/([A-Za-z0-9._-]+)/?$ /$1 [R=301,L,NE]

# Canonical public profiles live at /username. Existing files and directories
# always win so application, admin, API, asset and upload paths remain intact.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9][A-Za-z0-9._-]{1,58}[A-Za-z0-9])/?$ profile.php?username=$1 [L,QSA,NC]
</IfModule>
<FilesMatch "^(?:config\.php|config-example\.php|schema\.sql|upgrade-.*\.sql|\.env.*)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always set Permissions-Policy "microphone=(self), camera=(self)"
<FilesMatch "^(?:premium-voice-v117|chat-voice-v117|editor-voice-barge-v117|voice-lease-v122|conversation-voice-v120|conversation-voice-v121|conversation-voice-v122|chat-conversation-v121|editor-agent-v114|stem-agent-v114|video-header-v92|agent-activity-v94|chat-notifications-drawer-v240|chat-agent-identity-v236)\.js$">
Header always set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "^(?:chat-settings-v237|chat-notifications-drawer-v240|chat-agent-identity-v236)\.(?:js|css)$">
Header always set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>
