{
    "name": "vp3/phone-push-transport",
    "description": "Pinned production dependencies for the VP3 Phone Web Push worker",
    "type": "project",
    "license": "proprietary",
    "require": {
        "minishlink/web-push": "11.0.0",
        "nyholm/psr7": "1.8.2"
    },
    "config": {
        "allow-plugins": false,
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "platform-check": true,
        "sort-packages": true
    }
}
